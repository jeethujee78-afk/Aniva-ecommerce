# ============================================================================
# ANIVA E-COMMERCE PLATFORM — ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================================
# NOTE: In local development, all variables have safe in-memory fallbacks.
# Production values remain external secrets and must never be committed.
# ============================================================================

# --- Core Platform Settings ---
# GEMINI_API_KEY: Required for Gemini AI API calls.
# In AI Studio, this is automatically injected at runtime from managed user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# --- Database Configuration (PostgreSQL) ---
# For local development: Leave empty to use built-in development in-memory database with [DEMO DATA].
# To connect a local PostgreSQL instance: postgresql://postgres:postgres@localhost:5432/aniva_dev
# Production PostgreSQL/RDS credentials must be supplied via secure secret management.
DATABASE_URL=

# --- Caching & Rate Limiting (Redis) ---
# For local development: Leave empty to use built-in sliding-window memory rate limiter and cache.
# To connect a local Redis instance: redis://localhost:6379
# Production Redis/ElastiCache credentials must be supplied via secure secret management.
REDIS_URL=

# --- Managed Authentication Provider ---
# Supported providers: 'demo' | 'firebase' | 'supabase' | 'cognito'
# In development, 'demo' mode allows instant testing with demo accounts without external credentials.
AUTH_PROVIDER="demo"

# Managed Auth Project ID / Tenant Reference (e.g. your Firebase project ID or Supabase project URL)
# Leave empty in development to operate in demo mode.
AUTH_PROJECT_ID=

# --- Security & CORS ---
# In development: defaults to "*" or "http://localhost:3000"
# In production: comma-separated list of allowed origins (e.g. "https://aniva.in,https://www.aniva.in")
CORS_ORIGIN="*"
